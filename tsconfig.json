{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun-types", "@cloudflare/workers-types"]
  },
  "include": ["alchemy.run.ts", "src/**/*.ts", "test/**/*.ts"]
}
